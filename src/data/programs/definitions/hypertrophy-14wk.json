    {
      "weekday": "friday",
      "dayType": "lowerB",
      "title": "Lower B — Leg Press",
      "focus": "Quad volume, hamstrings, glutes, calves",
      "blocks": [
        {
          "key": "A",
          "label": "Main Lift",
          "exercises": [
            {
              "exercise": "leg-press",
